def _lang() -> str:
    for var in ("ROOTWHY_LANG", "LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var, "")
        if value:
            return "pl" if value.split(":")[0].lower().startswith("pl") else "en"
    return "en"


