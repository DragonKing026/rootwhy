# ── command model ───────────────────────────────────────────────────────────────────────────────────────────

@dataclass
class Token:
    shown: str              # what the dialog shows (quoted, control characters made visible)
    kind: str               # command | subcommand | option | value | path | arg | marker
    arg: str = ""           # the original argument (for a joined value: just the value)
    index: int = 0          # position in argv
    option: str = ""        # for options and their values: the option name
    role: str = ""          # e.g. source / destination / package / unit
    joined: bool = False    # no space before this token (value of --opt=value)
    notes: list[tuple[str, str]] = field(default_factory=list)  # (source, text) — filled by explain()


# zero-width and bidirectional-control characters: printable for Python, invisible (or misleading) on screen
INVISIBLE = {0x200B, 0x200C, 0x200D, 0x2060, 0xFEFF, *range(0x202A, 0x202F), *range(0x2066, 0x206A)}


def shell_quote(s: str) -> str:
    """Quote like a shell would need, and make invisible/control characters visible ($'…' form)."""
    if s and re.fullmatch(r"[\w@%+=:,./~-]+", s, re.ASCII):
        return s
    if any(not ch.isprintable() or ord(ch) in INVISIBLE for ch in s):
        out = []
        for ch in s:
            if ch == "\\" or ch == "'":
                out.append("\\" + ch)
            elif ch == "\n":
                out.append("\\n")
            elif ch == "\t":
                out.append("\\t")
            elif not ch.isprintable() or ord(ch) in INVISIBLE:
                out.append(f"\\x{ord(ch):02x}" if ord(ch) < 0x100 else f"\\u{ord(ch):04x}")
            else:
                out.append(ch)
        return "$'" + "".join(out) + "'"
    return "'" + s.replace("'", "'\\''") + "'"


def _looks_like_path(s: str) -> bool:
    return s.startswith(("/", "./", "../", "~")) or ("/" in s and not s.startswith("-") and "://" not in s)


def tokenize(argv: list[str], value_options: dict[str, set[str]] | None = None) -> list[Token]:
    """Split argv into display tokens. value_options: options known to take a value, per command name."""
    if not argv:
        return []
    cmd = os.path.basename(argv[0])
    takes = set(VALUE_OPTIONS.get(cmd, set()))
    if value_options:
        takes |= value_options.get(cmd, set())
    tokens = [Token(shell_quote(argv[0]), "command", argv[0], 0)]
    sub_done = cmd not in SUBCOMMAND_TOOLS
    end_of_options = False
    i = 1
    while i < len(argv):
        a = argv[i]
        if not end_of_options and a == "--":
            tokens.append(Token("--", "marker", a, i))
            end_of_options = True
        elif not end_of_options and a.startswith("--") and len(a) > 2:
            name, eq, value = a.partition("=")
            if eq:
                tokens.append(Token(shell_quote(name + "="), "option", a, i, name))
                tokens.append(Token(shell_quote(value), "value", value, i, name, joined=True))
            else:
                tokens.append(Token(shell_quote(a), "option", a, i, a))
                if a in takes and i + 1 < len(argv):
                    i += 1
                    tokens.append(Token(shell_quote(argv[i]), "value", argv[i], i, a))
        elif not end_of_options and a.startswith("-") and len(a) > 1 and not re.fullmatch(r"-\d+", a):
            short = a[:2]
            if short in takes and len(a) > 2:
                tokens.append(Token(shell_quote(short), "option", a, i, short))
                tokens.append(Token(shell_quote(a[2:]), "value", a[2:], i, short, joined=True))
            else:
                tokens.append(Token(shell_quote(a), "option", a, i, a))
                last = "-" + a[-1]
                if (a in takes or (len(a) > 2 and last in takes)) and i + 1 < len(argv):
                    i += 1
                    tokens.append(Token(shell_quote(argv[i]), "value", argv[i], i, a if a in takes else last))
        elif not sub_done:
            tokens.append(Token(shell_quote(a), "subcommand", a, i))
            sub_done = True
        else:
            tokens.append(Token(shell_quote(a), "path" if _looks_like_path(a) else "arg", a, i))
        i += 1
    _assign_roles(cmd, tokens)
    return tokens


def _assign_roles(cmd: str, tokens: list[Token]) -> None:
    positional = [t for t in tokens if t.kind in ("path", "arg")]
    options = {t.option for t in tokens if t.kind == "option"}
    sub = next((t.arg for t in tokens if t.kind == "subcommand"), "")
    if cmd in ("cp", "mv", "install", "ln") and positional:
        if options & {"-t", "--target-directory", "-d", "--directory"}:
            return
        if len(positional) == 1 and cmd == "ln":
            positional[0].role = "link target (what the link points to)"
            return
        *sources, dest = positional
        for t in sources:
            t.role = "link target (what the link points to)" if cmd == "ln" else "source"
        if sources:
            dest.role = "name of the link to create" if cmd == "ln" else "destination"
    elif cmd in ("rm", "rmdir"):
        for t in positional:
            t.role = "will be deleted"
    elif cmd in ("bash", "sh") and positional and "-c" not in options:
        positional[0].role = "script that will run as root"
    elif cmd == "systemctl" and sub in _UNIT_SUBS:
        for t in positional:
            t.role = "systemd unit"
    elif cmd in SUBCOMMANDS and sub in _PKG_SUBS and SUBCOMMANDS[cmd] is _PKG:
        for t in positional:
            t.role = "package"
    elif cmd == "chmod" and positional:
        positional[0].role = "mode"
    elif cmd in ("chown", "chgrp") and positional:
        positional[0].role = "owner"


def layout(tokens: list[Token]) -> list[list[Token]]:
    """Lines for the dialog: short commands on one line; otherwise command (+ subcommand) first, then each option
    with its value, each argument on its own line."""
    if not tokens:
        return []
    if sum(len(t.shown) + (0 if t.joined else 1) for t in tokens) <= ONE_LINE_MAX:
        return [tokens]
    lines: list[list[Token]] = [[]]
    for t in tokens:
        if t.kind == "subcommand" and len(lines) == 1:
            lines[0].append(t)
        elif t.joined or (t.kind == "value" and lines[-1] and lines[-1][-1].kind == "option"):
            lines[-1].append(t)
        elif t.kind == "command":
            lines[0].append(t)
        else:
            lines.append([t])
    return [line for line in lines if line]


