# ── command model ───────────────────────────────────────────────────────────────────────────────────────────

@dataclass
class Token:
    shown: str              # what the dialog shows (quoted, control characters made visible)
    kind: str               # command | subcommand | option | value | path | arg | marker
    arg: str = ""           # the original argument (for a joined value: just the value)
    index: int = 0          # position in argv
    option: str = ""        # for options and their values: the option name
    role: str = ""          # destination / script / mode / owner — see _assign_roles
    joined: bool = False    # no space before this token (value of --opt=value)
    notes: list[str] = field(default_factory=list)  # tooltip lines — filled by explain()


# zero-width and bidirectional-control characters: printable for Python, invisible (or misleading) on screen
INVISIBLE = {0x200B, 0x200C, 0x200D, 0x2060, 0xFEFF, *range(0x202A, 0x202F), *range(0x2066, 0x206A)}


def shell_quote(s: str) -> str:
    """Quote like a shell would need, and make invisible/control characters visible ($'…' form)."""
    if s and re.fullmatch(r"[\w@%+=:,./~-]+", s, re.ASCII):
        return s
    if any(not ch.isprintable() or ord(ch) in INVISIBLE for ch in s):
        out = []
        for ch in s:
            if ch == "\\" or ch == "'":
                out.append("\\" + ch)
            elif ch == "\n":
                out.append("\\n")
            elif ch == "\t":
                out.append("\\t")
            elif not ch.isprintable() or ord(ch) in INVISIBLE:
                out.append(f"\\x{ord(ch):02x}" if ord(ch) < 0x100 else f"\\u{ord(ch):04x}")
            else:
                out.append(ch)
        return "$'" + "".join(out) + "'"
    return "'" + s.replace("'", "'\\''") + "'"


def _looks_like_path(s: str) -> bool:
    return s.startswith(("/", "./", "../", "~")) or ("/" in s and not s.startswith("-") and "://" not in s)


def _short_command(path: str) -> str:
    """The bare name when sudo would find this very file by it (the full path is in the tooltip); otherwise the path —
    also when the file is unsafe, so the warning stays next to what is shown."""
    name = os.path.basename(path)
    found = shutil.which(name, path=SECURE_PATH)
    if path.startswith("/") and found and os.path.realpath(found) == os.path.realpath(path) \
            and not _unsafe_for_root(path) and not _unsafe_for_root(found):
        return name
    return path


def tokenize(argv: list[str], value_options: dict[str, set[str]] | None = None) -> list[Token]:
    """Split argv into display tokens. value_options: options known to take a value, per command name."""
    if not argv:
        return []
    cmd = os.path.basename(argv[0])
    takes = set(VALUE_OPTIONS.get(cmd, set()))
    if value_options:
        takes |= value_options.get(cmd, set())
    tokens = [Token(shell_quote(_short_command(argv[0])), "command", argv[0], 0)]
    sub_done = cmd not in SUBCOMMAND_TOOLS
    end_of_options = False
    i = 1
    while i < len(argv):
        a = argv[i]
        if not end_of_options and a == "--":
            tokens.append(Token("--", "marker", a, i))
            end_of_options = True
        elif not end_of_options and a.startswith("--") and len(a) > 2:
            name, eq, value = a.partition("=")
            if eq:
                tokens.append(Token(shell_quote(name + "="), "option", a, i, name))
                tokens.append(Token(shell_quote(value), "value", value, i, name, joined=True))
            else:
                tokens.append(Token(shell_quote(a), "option", a, i, a))
                if a in takes and i + 1 < len(argv):
                    i += 1
                    tokens.append(Token(shell_quote(argv[i]), "value", argv[i], i, a))
        elif not end_of_options and a.startswith("-") and len(a) > 1 and not re.fullmatch(r"-\d+", a):
            short = a[:2]
            if short in takes and len(a) > 2:
                tokens.append(Token(shell_quote(short), "option", a, i, short))
                tokens.append(Token(shell_quote(a[2:]), "value", a[2:], i, short, joined=True))
            else:
                tokens.append(Token(shell_quote(a), "option", a, i, a))
                last = "-" + a[-1]
                if (a in takes or (len(a) > 2 and last in takes)) and i + 1 < len(argv):
                    i += 1
                    tokens.append(Token(shell_quote(argv[i]), "value", argv[i], i, a if a in takes else last))
        elif not sub_done:
            tokens.append(Token(shell_quote(a), "subcommand", a, i))
            sub_done = True
        else:
            tokens.append(Token(shell_quote(a), "path" if _looks_like_path(a) else "arg", a, i))
        i += 1
    _assign_roles(cmd, tokens)
    return tokens


def _assign_roles(cmd: str, tokens: list[Token]) -> None:
    """Mark the arguments rootwhy checks for a warning: a destination that gets replaced, a script root will run,
    a permission mode, a new owner."""
    positional = [t for t in tokens if t.kind in ("path", "arg")]
    options = {t.option for t in tokens if t.kind == "option"}
    if cmd in ("cp", "mv", "install") and len(positional) > 1 and not options & {"-t", "--target-directory", "-d",
                                                                                 "--directory"}:
        positional[-1].role = "destination"
    elif cmd in ("bash", "sh") and positional and "-c" not in options:
        positional[0].role = "script"
    elif cmd == "chmod" and positional:
        positional[0].role = "mode"
    elif cmd in ("chown", "chgrp") and positional:
        positional[0].role = "owner"


def layout(tokens: list[Token]) -> list[list[Token]]:
    """Lines for the dialog: short commands on one line; otherwise command (+ subcommand) first, then each option
    with its value, each argument on its own line."""
    if not tokens:
        return []
    if sum(len(t.shown) + (0 if t.joined else 1) for t in tokens) <= ONE_LINE_MAX:
        return [tokens]
    lines: list[list[Token]] = [[]]
    for t in tokens:
        if t.kind == "subcommand" and len(lines) == 1:
            lines[0].append(t)
        elif t.joined or (t.kind == "value" and lines[-1] and lines[-1][-1].kind == "option"):
            lines[-1].append(t)
        elif t.kind == "command":
            lines[0].append(t)
        else:
            lines.append([t])
    return [line for line in lines if line]


# ── explanations ────────────────────────────────────────────────────────────────────────────────────────────

_MAN_CACHE: dict[str, tuple[str, dict[str, tuple[bool, str]]]] = {}


def _clean_man(text: str) -> str:
    text = re.sub(r".\x08", "", text)
    return re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", text)


def _shorten(description: str) -> str:
    """One readable sentence: hyphenation joined, first sentence only, at most 160 characters."""
    description = re.sub(r"\s+", " ", re.sub(r"‐\s+", "", description)).strip()
    description = re.split(r"(?<=[a-z\)])\.\s+(?=[A-Z])", description, maxsplit=1)[0]
    if len(description) > 160:
        description = description[:159].rsplit(" ", 1)[0] + "…"
    return description


def parse_man(text: str) -> tuple[str, dict[str, tuple[bool, str]]]:
    """From a rendered man page: (one-line summary, {option or subcommand: (takes_value, description)}).
    A subcommand entry is a lowercase word at the start of an indented line, described by the more-indented lines
    below it (like `start UNIT...` in systemctl(1))."""
    text = _clean_man(text)
    lines = text.splitlines()
    summary = ""
    for k, line in enumerate(lines):
        if line.strip() in ("NAME", "NAZWA") and k + 1 < len(lines):
            name_line = " ".join(x.strip() for x in lines[k + 1:k + 3] if x.strip())
            summary = re.split(r"\s+[-–—]\s+", name_line, maxsplit=1)[-1]
            summary = re.split(r"\s{2,}|\b[A-Z]{4,}\b", summary)[0].strip()
            break
    options: dict[str, tuple[bool, str]] = {}
    header = re.compile(r"^( {2,12})(--?[A-Za-z0-9?].*)$")
    word = re.compile(r"^( {2,12})([a-z][\w-]*)(?:\s+\S.*)?$")
    i = 0
    while i < len(lines):
        m = header.match(lines[i])
        if not m:
            w = word.match(lines[i])
            nxt = lines[i + 1] if i + 1 < len(lines) else ""
            if w and nxt.strip() and len(nxt) - len(nxt.lstrip()) > len(w.group(1)):
                desc, j = [], i + 1
                while j < len(lines) and lines[j].strip() and len(lines[j]) - len(lines[j].lstrip()) > len(w.group(1)):
                    desc.append(lines[j].strip())
                    j += 1
                options.setdefault(w.group(2), (False, _shorten(" ".join(desc))))
                i = j
            else:
                i += 1
            continue
        indent = len(m.group(1))
        parts = re.split(r"\s{2,}", m.group(2), maxsplit=1)  # description may follow on the same line
        spec, rest = parts[0], parts[1] if len(parts) > 1 else ""
        desc = [rest.strip()] if rest.strip() else []
        j = i + 1
        while j < len(lines) and lines[j].strip() and len(lines[j]) - len(lines[j].lstrip()) > indent:
            desc.append(lines[j].strip())
            j += 1
        names, takes = [], False
        for part in re.split(r",\s*", spec):
            nm = re.match(r"(--?[A-Za-z0-9?][\w-]*)(.*)$", part.strip())
            if not nm:
                continue
            names.append(nm.group(1))
            tail = nm.group(2)
            if not tail.startswith("[") and re.match(r"(=|\s+\S)", tail):
                takes = True
        for n in names:
            options.setdefault(n, (takes, _shorten(" ".join(desc))))
        i = j
    return summary, options


def man_info(cmd: str) -> tuple[str, dict[str, tuple[bool, str]]]:
    """Summary and options from `man` (never runs the command itself). Cached; empty when unavailable."""
    if cmd in _MAN_CACHE:
        return _MAN_CACHE[cmd]
    result: tuple[str, dict[str, tuple[bool, str]]] = ("", {})
    if re.fullmatch(r"[\w.+-]+", cmd) and shutil.which("man"):
        try:
            out = subprocess.run(["man", "-P", "cat", "--", cmd], check=False, capture_output=True, text=True, timeout=4,
                                 env={**os.environ, "MANWIDTH": "400", "MAN_KEEP_FORMATTING": "", "MANPAGER": "cat"},
                                 stdin=subprocess.DEVNULL)
            if out.returncode == 0:
                result = parse_man(out.stdout)
        except (OSError, subprocess.SubprocessError):
            pass
    _MAN_CACHE[cmd] = result
    return result


def mode_warning(value: str) -> str | None:
    if re.fullmatch(r"[0-7]{3,4}", value) and int(value, 8) & 0o6000:
        return _("⚠ setuid/setgid bit — runs with the owner's rights")
    return None


def owner_warning(value: str) -> str | None:
    user, _sep, group = value.partition(":")
    try:
        if user:
            pwd.getpwnam(user) if not user.isdigit() else pwd.getpwuid(int(user))
        if group:
            grp.getgrnam(group) if not group.isdigit() else grp.getgrgid(int(group))
    except (KeyError, ValueError):
        return _("⚠ no such user or group on this system")
    return None


def path_warnings(path: str, cwd: str | None = None, role: str = "") -> list[str]:
    """Only what deserves attention: a missing path, a destination that gets replaced, an unsafe script."""
    p = os.path.join(cwd or os.getcwd(), os.path.expanduser(path))
    if not os.path.lexists(p):
        parent = os.path.dirname(os.path.abspath(p)) or "/"
        if os.path.isdir(parent):
            return [_("does not exist yet (will be created)")] if role == "destination" else [_("⚠ does not exist")]
        return [_("⚠ does not exist, and neither does its parent directory")]
    if role == "destination" and os.path.isfile(p) and not os.path.islink(p):
        return [_("⚠ an existing file — it will be replaced")]
    if role == "script" and _unsafe_for_root(p):
        return [_("⚠ not owned by root or writable by others — could be changed before it runs")]
    return []


def _resolve_command(cmd: str) -> str | None:
    if "/" in cmd:
        return os.path.abspath(cmd)
    return shutil.which(cmd, path=SECURE_PATH)


def _unsafe_for_root(path: str) -> bool:
    """True when someone other than root could replace what runs: the file or any directory on its real path is not
    owned by root, or is writable by group/others (a sticky directory such as /tmp counts only for its own entries'
    owners). Errors count as unsafe."""
    if ".." in Path(path).parts:  # abspath would cancel "link/.." lexically, the kernel would follow the link
        return True
    try:
        # both the path as given (its symlinks and their directories) and where the symlinks lead
        for target in (Path(os.path.abspath(path)), Path(os.path.realpath(path))):
            for part in [target, *target.parents]:
                st = os.lstat(part)
                if stat.S_ISLNK(st.st_mode):
                    if st.st_uid != 0:
                        return True
                    continue  # a symlink's own mode bits mean nothing; its directory is checked next
                writable = st.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
                if part != target and stat.S_ISDIR(st.st_mode) and st.st_mode & stat.S_ISVTX:
                    writable = 0  # sticky: others cannot replace entries they do not own
                if st.st_uid != 0 or writable:
                    return True
    except OSError:
        return True
    return False


def _unit_description(unit: str) -> str:
    if not shutil.which("systemctl") or not re.fullmatch(r"[\w@.:-]+", unit):
        return ""
    try:
        out = subprocess.run(["systemctl", "show", "-p", "Description", "--value", "--", unit], check=False, capture_output=True,
                             text=True, timeout=2, stdin=subprocess.DEVNULL)
        return out.stdout.strip() if out.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def explain(tokens: list[Token], cwd: str | None = None, use_system: bool = True) -> None:
    """Fill token.notes from the system only: man pages (in the system's language, when translated) and checks of
    the files involved. A part the system says nothing about gets no tooltip."""
    if not tokens:
        return
    cmd = os.path.basename(tokens[0].arg)
    summary, man_entries = man_info(cmd) if use_system else ("", {})
    for t in tokens:
        if t.kind == "command":
            if summary:
                t.notes.append(summary)
            if use_system:
                resolved = _resolve_command(t.arg)
                if not resolved:
                    t.notes.append(_("⚠ not found in sudo's PATH"))
                elif _unsafe_for_root(resolved):
                    t.notes.append(resolved)
                    t.notes.append(_("⚠ not owned by root or writable by others — could be changed before it runs"))
        elif t.kind in ("subcommand", "option"):
            text = man_entries.get(t.option or t.arg, (False, ""))[1]
            if text:
                t.notes.append(text)
            elif t.kind == "option" and len(t.option) > 2 and not t.option.startswith("--"):  # -la → -l, -a
                t.notes += [f"-{ch}  {man_entries[f'-{ch}'][1]}" for ch in t.option[1:]
                            if man_entries.get(f"-{ch}", (False, ""))[1]]
        elif t.role == "mode":
            t.notes += [x for x in [mode_warning(t.arg)] if x]
        elif t.role == "owner" and use_system:
            t.notes += [x for x in [owner_warning(t.arg)] if x]
        elif t.kind == "value" and t.option in ("-m", "--mode") and cmd in ("install", "mkdir"):
            t.notes += [x for x in [mode_warning(t.arg)] if x]
        elif t.kind == "value" and t.option in ("-o", "--owner", "-g", "--group") and cmd == "install" and use_system:
            t.notes += [x for x in [owner_warning(":" + t.arg if t.option in ("-g", "--group") else t.arg)] if x]
        elif t.kind == "path" and use_system:
            t.notes += path_warnings(t.arg, cwd, t.role)


def _esc(s: str) -> str:
    """Escape for Pango markup (GTK, zenity) and Qt rich text (kdialog)."""
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def line_text(line: list[Token]) -> str:
    out = ""
    for t in line:
        out += t.shown if (t.joined or not out) else " " + t.shown
    return out


def tooltip_markup(token: Token) -> str:
    """Tooltip text, or "" when the system has nothing to say about this part."""
    return "\n".join(_esc(x) for x in token.notes)


