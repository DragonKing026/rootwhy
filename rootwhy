_MAN_CACHE: dict[str, tuple[str, dict[str, tuple[bool, str]]]] = {}


def _clean_man(text: str) -> str:
    text = re.sub(r".\x08", "", text)
    return re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", text)


def parse_man(text: str) -> tuple[str, dict[str, tuple[bool, str]]]:
    """From a rendered man page: (one-line summary, {option: (takes_value, description)})."""
    text = _clean_man(text)
    lines = text.splitlines()
    summary = ""
    for k, line in enumerate(lines):
        if line.strip() in ("NAME", "NAZWA") and k + 1 < len(lines):
            name_line = " ".join(x.strip() for x in lines[k + 1:k + 3] if x.strip())
            summary = re.split(r"\s+[-–—]\s+", name_line, maxsplit=1)[-1]
            summary = re.split(r"\s{2,}|\b[A-Z]{4,}\b", summary)[0].strip()
            break
    options: dict[str, tuple[bool, str]] = {}
    header = re.compile(r"^( {2,12})(--?[A-Za-z0-9?].*)$")
    i = 0
    while i < len(lines):
        m = header.match(lines[i])
        if not m:
            i += 1
            continue
        indent = len(m.group(1))
        parts = re.split(r"\s{2,}", m.group(2), maxsplit=1)  # description may follow on the same line
        spec, rest = parts[0], parts[1] if len(parts) > 1 else ""
        desc = [rest.strip()] if rest.strip() else []
        j = i + 1
        while j < len(lines) and lines[j].strip() and len(lines[j]) - len(lines[j].lstrip()) > indent:
            desc.append(lines[j].strip())
            j += 1
        names, takes = [], False
        for part in re.split(r",\s*", spec):
            nm = re.match(r"(--?[A-Za-z0-9?][\w-]*)(.*)$", part.strip())
            if not nm:
                continue
            names.append(nm.group(1))
            tail = nm.group(2)
            if not tail.startswith("[") and re.match(r"(=|\s+\S)", tail):
                takes = True
        description = " ".join(desc)
        description = re.sub(r"\s+", " ", re.sub(r"‐\s+", "", description)).strip()
        if len(description) > 240:
            description = description[:239].rsplit(" ", 1)[0] + "…"
        for n in names:
            options.setdefault(n, (takes, description))
        i = j
    return summary, options


def man_info(cmd: str) -> tuple[str, dict[str, tuple[bool, str]]]:
    """Summary and options from `man` (never runs the command itself). Cached; empty when unavailable."""
    if cmd in _MAN_CACHE:
        return _MAN_CACHE[cmd]
    result: tuple[str, dict[str, tuple[bool, str]]] = ("", {})
    if re.fullmatch(r"[\w.+-]+", cmd) and shutil.which("man"):
        try:
            out = subprocess.run(["man", "-P", "cat", "--", cmd], check=False, capture_output=True, text=True, timeout=4,
                                 env={**os.environ, "MANWIDTH": "400", "MAN_KEEP_FORMATTING": "", "MANPAGER": "cat"},
                                 stdin=subprocess.DEVNULL)
            if out.returncode == 0:
                result = parse_man(out.stdout)
        except (OSError, subprocess.SubprocessError):
            pass
    _MAN_CACHE[cmd] = result
    return result


def describe_mode(value: str) -> str | None:
    if not re.fullmatch(r"[0-7]{3,4}", value):
        return None
    mode = int(value, 8)
    rwx = stat.filemode(mode | stat.S_IFREG)[1:]

    def who(bits: int) -> str:
        parts = [n for b, n in ((4, _("read")), (2, _("write")), (1, _("execute"))) if bits & b]
        return ", ".join(parts) or _("nothing")

    text = _("permissions {r}: owner {o}; group {g}; others {x}", r=rwx, o=who(mode >> 6 & 7), g=who(mode >> 3 & 7),
             x=who(mode & 7))
    if mode & 0o6000:
        text += "\n" + _("⚠ setuid/setgid bit — runs with the owner's rights")
    return text


def describe_owner(value: str) -> str:
    user, _sep, group = value.partition(":")
    out = []
    try:
        if user:
            pw = pwd.getpwnam(user) if not user.isdigit() else pwd.getpwuid(int(user))
            out.append(_("user {u} (UID {i})", u=pw.pw_name, i=pw.pw_uid))
        if group:
            gr = grp.getgrnam(group) if not group.isdigit() else grp.getgrgid(int(group))
            out.append(_("group {g} (GID {i})", g=gr.gr_name, i=gr.gr_gid))
    except (KeyError, ValueError):
        return _("unknown user or group")
    return ", ".join(out)


def _human(size: int) -> str:
    for unit in ("B", "kB", "MB", "GB"):
        if size < 1024 or unit == "GB":
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return str(size)


def path_facts(path: str, cwd: str | None = None) -> list[str]:
    p = os.path.expanduser(path)
    if cwd and not os.path.isabs(p):
        p = os.path.join(cwd, p)
    facts = []
    try:
        st = os.lstat(p)
    except FileNotFoundError:
        parent = os.path.dirname(os.path.abspath(p)) or "/"
        facts.append(_("does not exist yet (will be created)") if os.path.isdir(parent)
                     else _("does not exist, and neither does its parent directory"))
        st = None
    except OSError:
        return [_("cannot be checked (no permission)")]
    if st is not None:
        if stat.S_ISLNK(st.st_mode):
            kind = _("symlink → {t}", t=os.readlink(p))
        elif stat.S_ISDIR(st.st_mode):
            kind = _("directory")
        elif stat.S_ISREG(st.st_mode):
            kind = f"{_('file')}, {_human(st.st_size)}"
        else:
            kind = _("special file")
        try:
            owner = pwd.getpwuid(st.st_uid).pw_name
        except KeyError:
            owner = str(st.st_uid)
        try:
            group = grp.getgrgid(st.st_gid).gr_name
        except KeyError:
            group = str(st.st_gid)
        facts.append(f"{kind}; " + _("owner {o}:{g}, {m}", o=owner, g=group, m=stat.filemode(st.st_mode)))
    absolute = os.path.abspath(p)
    home = os.path.expanduser("~")
    if absolute.startswith(home.rstrip("/") + "/"):
        facts.append(_("in your home directory"))
    else:
        for prefix, label in LOCATIONS:
            if absolute.startswith(prefix):
                facts.append(_(label))
                break
    return facts


def _resolve_command(cmd: str) -> str | None:
    if "/" in cmd:
        return os.path.abspath(cmd)
    return shutil.which(cmd, path=SECURE_PATH)


def _unsafe_for_root(path: str) -> bool:
    try:
        st = os.stat(path)
    except OSError:
        return False
    return st.st_uid != 0 or bool(st.st_mode & (stat.S_IWGRP | stat.S_IWOTH))


def _unit_description(unit: str) -> str:
    if not shutil.which("systemctl") or not re.fullmatch(r"[\w@.:-]+", unit):
        return ""
    try:
        out = subprocess.run(["systemctl", "show", "-p", "Description", "--value", "--", unit], check=False, capture_output=True,
                             text=True, timeout=2, stdin=subprocess.DEVNULL)
        return out.stdout.strip() if out.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def _agent_matches(token: Token, fragment: str) -> bool:
    if fragment in (token.arg, token.shown, token.option):
        return True
    if token.kind in ("path", "value", "arg", "command") and "/" in token.arg:
        return token.arg.endswith("/" + fragment.lstrip("/")) or os.path.basename(token.arg) == fragment
    return False


def explain(tokens: list[Token], agent: dict[str, str] | None = None, cwd: str | None = None,
            use_system: bool = True) -> list[str]:
    """Fill token.notes. Returns the requester's notes that matched no token (shown separately)."""
    agent = agent or {}
    used: set[str] = set()
    if not tokens:
        return list(agent.values())
    cmd = os.path.basename(tokens[0].arg)
    summary, man_opts = man_info(cmd) if use_system else ("", {})
    for t in tokens:
        for fragment, text in agent.items():
            if _agent_matches(t, fragment):
                t.notes.append(("agent", text))
                used.add(fragment)
        builtin: list[str] = []
        system: list[str] = []
        if t.kind == "command":
            builtin.append(f"{_('command')}: {L(*COMMANDS[cmd])}" if cmd in COMMANDS else _("command"))
            if summary:
                system.append(f"man {cmd}: {summary}")
            if use_system:
                resolved = _resolve_command(t.arg)
                if resolved:
                    system.append(_("root will run {p}", p=resolved))
                    system += path_facts(resolved, cwd)
                    if _unsafe_for_root(resolved):
                        system.append(_("⚠ not owned by root or writable by others — could be changed before it runs"))
                else:
                    system.append(_("not found in sudo's PATH"))
        elif t.kind == "subcommand":
            text = SUBCOMMANDS.get(cmd, {}).get(t.arg)
            builtin.append(f"{_('subcommand')}: {L(*text)}" if text else _("subcommand"))
        elif t.kind == "option":
            text = OPTIONS.get(cmd, {}).get(t.option)
            if not text and len(t.option) > 2 and not t.option.startswith("--"):
                letters = [OPTIONS.get(cmd, {}).get("-" + ch) for ch in t.option[1:]]
                if all(letters):
                    text = tuple("; ".join(x[k] for x in letters) for k in (0, 1))
            builtin.append(f"{_('option')}: {L(*text)}" if text else _("option"))
            man_text = man_opts.get(t.option, (False, ""))[1]
            if not man_text and len(t.option) > 2 and not t.option.startswith("--"):
                man_text = "; ".join(man_opts[f"-{ch}"][1] for ch in t.option[1:] if f"-{ch}" in man_opts)
            if man_text:
                system.append(f"man {cmd}: {man_text}")
        elif t.kind == "value":
            builtin.append(_("value of {o}", o=t.option))
            opt = t.option
            if opt in ("-m", "--mode") and cmd in ("install", "mkdir"):
                mode = describe_mode(t.arg)
                if mode:
                    system.append(mode)
            elif opt in ("-o", "--owner", "-g", "--group") and cmd == "install" and use_system:
                system.append(describe_owner(":" + t.arg if opt in ("-g", "--group") else t.arg))
            elif opt in ("-t", "--target-directory") or _looks_like_path(t.arg):
                if use_system:
                    system += path_facts(t.arg, cwd)
        elif t.kind == "marker":
            builtin.append(_("end of options — everything after is an argument"))
        else:  # path / arg
            label = _("path") if t.kind == "path" else _("argument")
            if t.role == "mode":
                builtin.append(L("permissions", "prawa dostępu"))
                mode = describe_mode(t.arg)
                if mode:
                    system.append(mode)
            elif t.role == "owner":
                builtin.append(L("new owner", "nowy właściciel"))
                if use_system:
                    system.append(describe_owner(t.arg))
            else:
                builtin.append(f"{label}: {_(t.role)}" if t.role else label)
            if t.role == "systemd unit" and use_system:
                desc = _unit_description(t.arg)
                if desc:
                    system.append(_("unit: {d}", d=desc))
            if t.kind == "path" and use_system:
                facts = path_facts(t.arg, cwd)
                system += facts
                p = os.path.join(cwd or os.getcwd(), os.path.expanduser(t.arg))
                if t.role == "destination" and os.path.isfile(p) and not os.path.islink(p):
                    system.append(_("⚠ an existing file — it will be replaced"))
                elif t.role == "destination" and os.path.isdir(p):
                    system.append(_("files will be placed in this directory"))
                if t.role == "script that will run as root" and os.path.isfile(p) and _unsafe_for_root(p):
                    system.append(_("⚠ not owned by root or writable by others — could be changed before it runs"))
        t.notes += [("builtin", x) for x in builtin] + [("system", x) for x in system]
    return [text for fragment, text in agent.items() if fragment not in used]


def _esc(s: str) -> str:
    """Escape for Pango markup (GTK, zenity) and Qt rich text (kdialog)."""
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def line_text(line: list[Token]) -> str:
    out = ""
    for t in line:
        out += t.shown if (t.joined or not out) else " " + t.shown
    return out


def tooltip_markup(token: Token) -> str:
    escape = _esc
    sections = []
    agent = [x for s, x in token.notes if s == "agent"]
    builtin = [x for s, x in token.notes if s == "builtin"]
    system = [x for s, x in token.notes if s == "system"]
    if agent:
        sections.append(f"<b>{escape(_('Requester says'))}</b> <i>({escape(_('claim, not verified'))})</i>\n"
                        + "\n".join(escape(x) for x in agent))
    if builtin:
        sections.append("\n".join(escape(x) for x in builtin))
    if system:
        sections.append(f"<b>{escape(_('Checked now'))}</b>\n" + "\n".join(escape(x) for x in system))
    return "\n\n".join(sections) or escape(token.arg)


