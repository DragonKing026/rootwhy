def gtk_dialog(req: Request) -> str | None:
    """GTK 4 dialog. Returns the password, None when cancelled. Raises ImportError/RuntimeError without GTK 4."""
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    gi.require_version("Pango", "1.0")
    from gi.repository import Gdk, GLib, Gtk, Pango

    if not Gtk.init_check():
        raise RuntimeError("GTK cannot open a display")
    tokens = tokenize(req.argv, {os.path.basename(req.argv[0]): {k for k, v in man_info(
        os.path.basename(req.argv[0]))[1].items() if v[0]}} if req.argv else None)
    leftover = explain(tokens, req.explanations, req.cwd or None)
    result: dict[str, str | None] = {"password": None}
    loop = GLib.MainLoop()

    win = Gtk.Window(title=f"rootwhy — {_('Administrator access')}")
    win.set_default_size(860, -1)
    win.set_resizable(True)

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    for side in ("top", "bottom", "start", "end"):
        getattr(outer, f"set_margin_{side}")(18)
    win.set_child(outer)

    head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
    logo = Path(__file__).resolve().parent / "logo.svg"
    icon = Gtk.Image.new_from_file(str(logo)) if logo.is_file() else Gtk.Image.new_from_icon_name("dialog-password")
    icon.set_pixel_size(48)
    icon.set_valign(Gtk.Align.START)
    head.append(icon)
    texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    texts.set_hexpand(True)
    head.append(texts)
    outer.append(head)

    def label(text: str, css: str = "", markup: bool = False, wrap: bool = True) -> Gtk.Label:
        lbl = Gtk.Label()
        lbl.set_markup(text) if markup else lbl.set_text(text)
        lbl.set_xalign(0)
        lbl.set_wrap(wrap)
        lbl.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        if css:
            for c in css.split():
                lbl.add_css_class(c)
        return lbl

    if req.attempt > 1:
        texts.append(label(_("Wrong password — try again (attempt {n}).", n=req.attempt), "rw-error"))
    if req.preview:
        texts.append(label(_("Preview — nothing will run."), "rw-dim"))
    texts.append(label(req.reason, "rw-reason"))

    outer.append(label(_("Command (hover over a part for an explanation):"), "rw-dim"))
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    box.add_css_class("rw-box")
    lines = layout(tokens)
    for n, line in enumerate(lines):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        if n:
            row.set_margin_start(28)
        for t in line:
            if not t.joined and row.get_first_child() is not None:
                row.append(Gtk.Label(label=" "))
            tok = Gtk.Label(label=t.shown)
            tok.set_xalign(0)
            if len(t.shown) > 110:  # only very long parts wrap; the window grows for the rest
                tok.set_wrap(True)
                tok.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
                tok.set_width_chars(110)
                tok.set_max_width_chars(110)
            tok.set_selectable(False)
            tok.add_css_class("rw-tok")
            tok.add_css_class(f"rw-k-{t.kind}")
            tok.set_tooltip_markup(tooltip_markup(t))
            row.append(tok)
        if n < len(lines) - 1:
            cont = Gtk.Label(label=" \\")
            cont.add_css_class("rw-cont")
            row.append(cont)
        box.append(row)
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    scroll.set_propagate_natural_height(True)
    scroll.set_max_content_height(420)
    scroll.set_child(box)
    outer.append(scroll)

    if leftover:
        outer.append(label(_("Other notes from the requester:") + "\n" + "\n".join(f"• {x}" for x in leftover),
                           "rw-dim"))
    meta = [_("Working directory: {d}", d=req.cwd)] if req.cwd else []
    if req.caller:
        meta.append(_("Requested by: {c}", c=req.caller))
    if meta:
        outer.append(label("\n".join(meta), "rw-dim"))

    entry = Gtk.PasswordEntry()
    entry.set_show_peek_icon(True)
    entry.set_hexpand(True)
    pw_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    pw_row.append(label(_("Password:"), wrap=False))
    pw_row.append(entry)
    outer.append(pw_row)

    buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    buttons.set_halign(Gtk.Align.END)
    cancel = Gtk.Button(label=_("Cancel"))
    ok = Gtk.Button(label=_("Authorize"))
    ok.add_css_class("suggested-action")
    buttons.append(cancel)
    buttons.append(ok)
    outer.append(buttons)

    def finish(password: str | None) -> None:
        result["password"] = password
        win.destroy()
        loop.quit()

    ok.connect("clicked", lambda *_a: finish(entry.get_text()))
    entry.connect("activate", lambda *_a: finish(entry.get_text()))
    cancel.connect("clicked", lambda *_a: finish(None))
    win.connect("close-request", lambda *_a: (finish(None), False)[1])
    keys = Gtk.EventControllerKey()
    keys.connect("key-pressed", lambda _c, keyval, *_a: (finish(None), True)[1] if keyval == Gdk.KEY_Escape else False)
    win.add_controller(keys)

    # palette from the theme's text colour: light text → dark theme
    probe = Gtk.Label()
    outer.append(probe)
    win.present()
    color = probe.get_color()
    outer.remove(probe)
    dark = (0.2126 * color.red + 0.7152 * color.green + 0.0722 * color.blue) > 0.5
    css = CSS.format(**PALETTES["dark" if dark else "light"])
    provider = Gtk.CssProvider()
    if hasattr(provider, "load_from_string"):  # GTK ≥ 4.12
        provider.load_from_string(css)
    else:
        provider.load_from_data(css.encode(), -1)
    add_provider = getattr(Gtk, "style_context_add_provider_for_display", None) or \
        Gtk.StyleContext.add_provider_for_display
    add_provider(win.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    entry.grab_focus()

    if req.screenshot:
        def shoot() -> bool:
            w, h = win.get_width(), win.get_height()
            paintable = Gtk.WidgetPaintable.new(win)
            snap = Gtk.Snapshot()
            paintable.snapshot(snap, w, h)
            node = snap.to_node()
            if node is not None:
                win.get_renderer().render_texture(node, None).save_to_png(req.screenshot)
            finish(None)
            return False
        GLib.timeout_add(700, shoot)

    loop.run()
    return result["password"]


def fallback_dialog(req: Request) -> str | None:
    """kdialog / zenity: no colours or hover, but the same reason and the command split into lines."""
    lines = [line_text(line) for line in layout(tokenize(req.argv))]
    lines = [("    " if n else "") + line + (" \\" if n < len(lines) - 1 else "") for n, line in enumerate(lines)]
    retry = _("Wrong password — try again (attempt {n}).", n=req.attempt) if req.attempt > 1 else ""
    title = f"rootwhy — {_('Administrator access')}"
    if shutil.which("kdialog"):
        body = "<br>".join(_esc(x).replace("  ", "&nbsp;&nbsp;") for x in lines)
        text = (f"<p><b>{_esc(retry)}</b></p>" if retry else "") + f"<p>{_esc(req.reason)}</p><p><code>{body}</code></p>"
        cmd = ["kdialog", "--title", title, "--password", text]
    elif shutil.which("zenity"):
        text = (f"<b>{_esc(retry)}</b>\n\n" if retry else "") + f"{_esc(req.reason)}\n\n<tt>" + \
            "\n".join(_esc(x) for x in lines) + "</tt>"
        cmd = ["zenity", "--entry", "--hide-text", "--title", title, "--width", "760", "--text", text]
    else:
        raise RuntimeError(_("rootwhy: no dialog available (GTK 4, kdialog or zenity)"))
    out = subprocess.run(cmd, check=False, capture_output=True, text=True, stdin=subprocess.DEVNULL)
    return out.stdout.rstrip("\n") if out.returncode == 0 else None


def show_dialog(req: Request) -> str | None:
    if os.environ.get("ROOTWHY_DIALOG") != "fallback":
        try:
            return gtk_dialog(req)
        except (ImportError, ValueError, RuntimeError, AttributeError):
            if req.screenshot:
                raise
    return fallback_dialog(req)


# ── modes ───────────────────────────────────────────────────────────────────────────────────────────────────

def _parent_comm(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def _caller_chain(pid: int, depth: int = 3) -> str:
    names = []
    for _i in range(depth):
        try:
            stat_line = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            break
        names.append(stat_line[stat_line.index("(") + 1:stat_line.rindex(")")])
        pid = int(stat_line[stat_line.rindex(")") + 2:].split()[1])
        if pid <= 1:
            break
    return " ← ".join(names)


def askpass_mode() -> int:
    """Run by sudo -A: show the dialog, print the password. Only when the parent process is sudo — an inherited
    environment must not turn this into a password prompt for whoever started it."""
    if _parent_comm(os.getppid()) != "sudo":
        print(_("rootwhy: askpass mode is only for sudo -A"), file=sys.stderr)
        return 1
    state = os.environ.get("ROOTWHY_STATE", "")
    previous = ""
    if state:
        try:
            previous = Path(state).read_text().strip()
        except OSError:
            pass
    if previous == "cancelled":  # sudo asks again after a cancel — no second dialog
        return 1
    attempt = int(previous) + 1 if previous.isdigit() else 1
    if state:
        Path(state).write_text(str(attempt))
    try:
        argv = json.loads(os.environ.get("ROOTWHY_ARGV", "[]"))
        explanations = json.loads(os.environ.get("ROOTWHY_EXPLAIN", "{}"))
    except json.JSONDecodeError:
        argv, explanations = [], {}
    if not argv:
        argv = [os.environ.get("ROOTWHY_COMMAND", "?")]
    req = Request(reason=os.environ.get("ROOTWHY_REASON", ""), argv=[str(a) for a in argv],
                  explanations={str(k): str(v) for k, v in dict(explanations).items()}, attempt=attempt,
                  cwd=os.environ.get("ROOTWHY_CWD", ""), caller=os.environ.get("ROOTWHY_CALLER", ""))
    password = show_dialog(req)
    if password is None:
        if state:
            Path(state).write_text("cancelled")
        return 1
    sys.stdout.write(password + "\n")
    sys.stdout.flush()
    return 0


def _clean(text: str) -> str:
    return re.sub(r"[\x00-\x1f\x7f]", " ", text).strip()


def _log(log_dir: Path, reason: str, command: str, status: str) -> None:
    try:
        log_dir.mkdir(parents=True, exist_ok=True)
        now = _dt.datetime.now()
        with open(log_dir / f"{now:%Y%m}.log", "a", encoding="utf-8") as f:
            f.write(f"{now:%Y-%m-%d %H:%M:%S} | {reason} | {command} | {status}\n")
    except OSError as e:
        print(f"rootwhy: log: {e}", file=sys.stderr)


def parse_args(args: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="rootwhy",
        description=L("Run a command as root after a password dialog that shows why and explains each part.",
                      "Uruchamia polecenie jako root po haśle w okienku, które mówi po co i wyjaśnia każdy fragment."),
        epilog=L('Example: rootwhy -r "Restart Ollama after changing its service file." '
                 '-e ollama="the local AI model server" systemctl restart ollama',
                 'Przykład: rootwhy -r "Restart Ollamy po zmianie pliku usługi." '
                 '-e ollama="serwer lokalnych modeli AI" systemctl restart ollama'))
    p.add_argument("-r", "--reason", default="",
                   help=L(f"why the command is needed, {REASON_MIN}–{REASON_MAX} characters (required)",
                          f"po co jest polecenie, {REASON_MIN}–{REASON_MAX} znaków (wymagane)"))
    p.add_argument("-e", "--explain", action="append", default=[], metavar="FRAGMENT=TEXT",
                   help=L("explanation shown on hover over the matching part (repeatable)",
                          "wyjaśnienie po najechaniu na pasujący fragment (można powtarzać)"))
    p.add_argument("--log-dir", default=os.environ.get("ROOTWHY_LOG_DIR", ""),
                   help=L("log directory (default: $XDG_STATE_HOME/rootwhy)",
                          "katalog dziennika (domyślnie $XDG_STATE_HOME/rootwhy)"))
    p.add_argument("--preview", action="store_true",
                   help=L("only show the dialog; run nothing", "tylko pokaż okienko; niczego nie uruchamiaj"))
    p.add_argument("--screenshot", default="", metavar="PNG", help=argparse.SUPPRESS)
    p.add_argument("--version", action="version", version=f"rootwhy {VERSION}")
    p.add_argument("command", nargs=argparse.REMAINDER)
    ns = p.parse_args(args)
    if ns.command and ns.command[0] == "--":
        ns.command = ns.command[1:]
    return ns


def main_mode(args: list[str]) -> int:
    ns = parse_args(args)
    reason = _clean(ns.reason)
    if not REASON_MIN <= len(reason) <= REASON_MAX:
        print(_("rootwhy: reason (-r) is required, {a}–{b} characters", a=REASON_MIN, b=REASON_MAX), file=sys.stderr)
        return 2
    if not ns.command:
        print(_("rootwhy: no command given"), file=sys.stderr)
        return 2
    explanations: dict[str, str] = {}
    for item in ns.explain:
        fragment, eq, text = item.partition("=")
        if not eq or not fragment or not text.strip():
            print(_("rootwhy: bad --explain, expected FRAGMENT=TEXT: {e}", e=item), file=sys.stderr)
            return 2
        explanations[fragment] = _clean(text)[:EXPLAIN_MAX]
    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        print(_("rootwhy: no graphical session for the dialog"), file=sys.stderr)
        return 2
    caller = _caller_chain(os.getppid())
    if ns.preview or ns.screenshot:
        req = Request(reason, ns.command, explanations, cwd=os.getcwd(), caller=caller, preview=True,
                      screenshot=ns.screenshot)
        return 0 if show_dialog(req) is not None else 130

    command = " ".join(shell_quote(a) for a in ns.command)
    log_dir = Path(ns.log_dir) if ns.log_dir else \
        Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "rootwhy"
    _log(log_dir, reason, command, "start")
    fd, state = tempfile.mkstemp(prefix="rootwhy.", dir=os.environ.get("XDG_RUNTIME_DIR") or None)
    os.close(fd)
    env = {k: v for k, v in os.environ.items() if not k.startswith(("ROOTWHY_", "SUDO_"))}
    env.update(ROOTWHY_MODE="askpass", ROOTWHY_STATE=state, ROOTWHY_REASON=reason,
               ROOTWHY_ARGV=json.dumps(ns.command), ROOTWHY_EXPLAIN=json.dumps(explanations),
               ROOTWHY_CWD=os.getcwd(), ROOTWHY_CALLER=caller, SUDO_ASKPASS=os.path.realpath(__file__))
    try:
        sudo = "/usr/bin/sudo" if os.path.exists("/usr/bin/sudo") else "sudo"
        code = subprocess.run([sudo, "-k", "-A", "--", *ns.command], check=False, env=env).returncode
        cancelled = Path(state).read_text().strip() == "cancelled"
    except KeyboardInterrupt:
        code, cancelled = 130, False
    finally:
        Path(state).unlink(missing_ok=True)
    if cancelled:
        code = 130
        print(_("rootwhy: cancelled by the user"), file=sys.stderr)
    _log(log_dir, reason, command, f"exit {code}")
    return code


def main() -> int:
    if os.environ.get("ROOTWHY_MODE") == "askpass":
        return askpass_mode()
    return main_mode(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
