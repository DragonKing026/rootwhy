.rw-k-option {{ color: {opt}; }}
.rw-k-value {{ color: {val}; }}
.rw-k-path {{ color: {path}; }}
.rw-k-marker, .rw-cont {{ opacity: 0.55; }}
"""
PALETTES = {
    "light": {"cmd": "#1a5fb4", "opt": "#813d9c", "val": "#b04a00", "path": "#1c7a43", "error": "#c01c28",
              "bg": "rgba(0,0,0,0.05)", "hover": "rgba(0,0,0,0.10)"},
    "dark": {"cmd": "#78aeed", "opt": "#dc8add", "val": "#ffa348", "path": "#8ff0a4", "error": "#ff7b63",
             "bg": "rgba(255,255,255,0.06)", "hover": "rgba(255,255,255,0.14)"},
}


def _load_gtk():
    """Gtk 4, else Gtk 3 (ROOTWHY_GTK=3 forces 3). Returns (Gtk, Gdk, GLib, Pango, major)."""
    import gi
    for major in (("3.0",) if os.environ.get("ROOTWHY_GTK") == "3" else ("4.0", "3.0")):
        try:
            gi.require_version("Gtk", major)
            gi.require_version("Gdk", major)
            gi.require_version("Pango", "1.0")
            from gi.repository import Gdk, GLib, Gtk, Pango
            return Gtk, Gdk, GLib, Pango, int(major[0])
        except ValueError:
            continue
    raise ImportError("no GTK 4 or GTK 3 for Python")


def gtk_dialog(req: Request) -> str | None:
    """GTK 4 (or GTK 3) dialog. Returns the password, None when cancelled. Raises ImportError/RuntimeError without
    GTK."""
    Gtk, Gdk, GLib, Pango, major = _load_gtk()
    v4 = major == 4
    if not (Gtk.init_check() if v4 else Gtk.init_check(None)[0]):
        raise RuntimeError("GTK cannot open a display")
    tokens = tokenize(req.argv, {os.path.basename(req.argv[0]): {k for k, v in man_info(
        os.path.basename(req.argv[0]))[1].items() if v[0]}} if req.argv else None)
    explain(tokens, req.cwd or None)
    result: dict[str, str | None] = {"password": None}
    loop = GLib.MainLoop()

    # the few calls that differ between GTK 3 and 4
    def add(box, child, expand: bool = False) -> None:
        box.append(child) if v4 else box.pack_start(child, expand, expand, 0)

    def css_class(widget, name: str) -> None:
        widget.add_css_class(name) if v4 else widget.get_style_context().add_class(name)

    def wrap(lbl, on: bool = True) -> None:
        if v4:
            lbl.set_wrap(on)
            lbl.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        else:
            lbl.set_line_wrap(on)
            lbl.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)

    def label(text: str, css: str = "", do_wrap: bool = True):
        lbl = Gtk.Label(label=text)
        lbl.set_xalign(0)
        wrap(lbl, do_wrap)
        for c in css.split():
            css_class(lbl, c)
        return lbl

    def logo_image():
        try:
            if v4:
                texture = Gdk.Texture.new_from_bytes(GLib.Bytes.new(LOGO_SVG.encode()))
                image = Gtk.Image.new_from_paintable(texture)
                image.set_pixel_size(48)
                return image
            gi_pixbuf = __import__("gi.repository.GdkPixbuf", fromlist=["GdkPixbuf"])
            loader = gi_pixbuf.PixbufLoader()
            loader.set_size(48, 48)
            loader.write(LOGO_SVG.encode())
            loader.close()
            return Gtk.Image.new_from_pixbuf(loader.get_pixbuf())
        except Exception:  # no SVG loader — the theme's icon will do
            if v4:
                image = Gtk.Image.new_from_icon_name("dialog-password")
                image.set_pixel_size(48)
                return image
            return Gtk.Image.new_from_icon_name("dialog-password", Gtk.IconSize.DIALOG)

    win = Gtk.Window(title=f"rootwhy — {_('Administrator access')}")
    win.set_default_size(860, -1)
    win.set_resizable(True)

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    for side in ("top", "bottom", "start", "end"):
        getattr(outer, f"set_margin_{side}")(18)
    win.set_child(outer) if v4 else win.add(outer)

    head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
    icon = logo_image()
    icon.set_valign(Gtk.Align.START)
    add(head, icon)
    texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    texts.set_hexpand(True)
    add(head, texts, expand=True)
    add(outer, head)

    if req.attempt > 1:
        add(texts, label(_("Wrong password — try again (attempt {n}).", n=req.attempt), "rw-error"))
    if req.preview:
        add(texts, label(_("Preview — nothing will run."), "rw-dim"))
    add(texts, label(req.reason, "rw-reason"))

    add(outer, label(_("Command (hover over a part for its description from the system's manual):"), "rw-dim"))
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    css_class(box, "rw-box")
    lines = layout(tokens)
    for n, line in enumerate(lines):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        if n:
            row.set_margin_start(28)
        for k, t in enumerate(line):
            if k and not t.joined:
                add(row, Gtk.Label(label=" "))
            tok = Gtk.Label(label=t.shown)
            tok.set_xalign(0)
            if len(t.shown) > 110:  # only very long parts wrap; the window grows for the rest
                wrap(tok)
                tok.set_width_chars(110)
                tok.set_max_width_chars(110)
            tok.set_selectable(False)
            css_class(tok, "rw-tok")
            css_class(tok, f"rw-k-{t.kind}")
            if t.notes:
                tok.set_tooltip_markup(tooltip_markup(t))
            add(row, tok)
        if n < len(lines) - 1:
            cont = Gtk.Label(label=" \\")
            css_class(cont, "rw-cont")
            add(row, cont)
        add(box, row)
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    scroll.set_propagate_natural_height(True)
    scroll.set_max_content_height(420)
    scroll.set_child(box) if v4 else scroll.add(box)
    add(outer, scroll)

    meta = [_("Working directory: {d}", d=req.cwd)] if req.cwd else []
    if req.caller:
        meta.append(_("Requested via: {c} (the programs the request came through)", c=req.caller))
    if meta:
        add(outer, label("\n".join(meta), "rw-dim"))

    if v4:
        entry = Gtk.PasswordEntry()
        entry.set_show_peek_icon(True)
    else:
        entry = Gtk.Entry()
        entry.set_visibility(False)
        entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
    entry.set_hexpand(True)
    pw_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    add(pw_row, label(_("Password:"), do_wrap=False))
    add(pw_row, entry, expand=True)
    add(outer, pw_row)

    buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    buttons.set_halign(Gtk.Align.END)
    cancel = Gtk.Button(label=_("Cancel"))
    ok = Gtk.Button(label=_("Authorize"))
    css_class(ok, "suggested-action")
    add(buttons, cancel)
    add(buttons, ok)
    add(outer, buttons)

    def finish(password: str | None) -> None:
        if loop.is_running():
            result["password"] = password
            win.destroy()
            loop.quit()

    ok.connect("clicked", lambda *_a: finish(entry.get_text()))
    entry.connect("activate", lambda *_a: finish(entry.get_text()))
    cancel.connect("clicked", lambda *_a: finish(None))
    if v4:
        win.connect("close-request", lambda *_a: (finish(None), False)[1])
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed",
                     lambda _c, keyval, *_a: (finish(None), True)[1] if keyval == Gdk.KEY_Escape else False)
        win.add_controller(keys)
    else:
        win.connect("delete-event", lambda *_a: (finish(None), False)[1])
        win.connect("key-press-event",
                    lambda _w, ev: (finish(None), True)[1] if ev.keyval == Gdk.KEY_Escape else False)

    # palette from the theme's text colour: light text → dark theme
    probe = Gtk.Label()
    add(outer, probe)
    if v4:
        win.present()
        color = probe.get_color()
        outer.remove(probe)
    else:
        win.show_all()
        color = probe.get_style_context().get_color(Gtk.StateFlags.NORMAL)
        outer.remove(probe)
    dark = (0.2126 * color.red + 0.7152 * color.green + 0.0722 * color.blue) > 0.5
    css = CSS.format(**PALETTES["dark" if dark else "light"])
    provider = Gtk.CssProvider()
    if v4 and hasattr(provider, "load_from_string"):  # GTK ≥ 4.12
        provider.load_from_string(css)
    elif v4:
        provider.load_from_data(css.encode(), -1)
    else:
        provider.load_from_data(css.encode())
    if v4:
        add_provider = getattr(Gtk, "style_context_add_provider_for_display", None) or \
            Gtk.StyleContext.add_provider_for_display
        add_provider(win.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    else:
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    entry.grab_focus()

    if req.screenshot:
        def shoot() -> bool:
            if v4:
                w, h = win.get_width(), win.get_height()
                paintable = Gtk.WidgetPaintable.new(win)
                snap = Gtk.Snapshot()
                paintable.snapshot(snap, w, h)
                node = snap.to_node()
                if node is not None:
                    win.get_renderer().render_texture(node, None).save_to_png(req.screenshot)
            else:
                import cairo
                alloc = win.get_allocation()
                surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, alloc.width, alloc.height)
                win.draw(cairo.Context(surface))
                surface.write_to_png(req.screenshot)
            finish(None)
            return False
        GLib.timeout_add(700, shoot)

    loop.run()
    return result["password"]


def fallback_dialog(req: Request) -> str | None:
    """kdialog / zenity: no colours or hover, but the same reason and the command split into lines."""
    lines = [line_text(line) for line in layout(tokenize(req.argv))]
    lines = [("    " if n else "") + line + (" \\" if n < len(lines) - 1 else "") for n, line in enumerate(lines)]
    retry = _("Wrong password — try again (attempt {n}).", n=req.attempt) if req.attempt > 1 else ""
    title = f"rootwhy — {_('Administrator access')}"
    kdialog, zenity = shutil.which("kdialog", path=SECURE_PATH), shutil.which("zenity", path=SECURE_PATH)
    if kdialog:
        body = "<br>".join(_esc(x).replace("  ", "&nbsp;&nbsp;") for x in lines)
        text = (f"<p><b>{_esc(retry)}</b></p>" if retry else "") + f"<p>{_esc(req.reason)}</p><p><code>{body}</code></p>"
        cmd = [kdialog, "--title", title, "--password", text]
    elif zenity:
        text = (f"<b>{_esc(retry)}</b>\n\n" if retry else "") + f"{_esc(req.reason)}\n\n<tt>" + \
            "\n".join(_esc(x) for x in lines) + "</tt>"
        cmd = [zenity, "--entry", "--hide-text", "--title", title, "--width", "760", "--text", text]
    else:
        raise RuntimeError(_("rootwhy: no dialog available (GTK 4, kdialog or zenity)"))
    out = subprocess.run(cmd, check=False, capture_output=True, text=True, stdin=subprocess.DEVNULL)
    return out.stdout.rstrip("\n") if out.returncode == 0 else None


def _gtk_quiet(req: Request) -> str | None:
    """gtk_dialog with stderr muted: theme warnings (Gtk-WARNING …) are noise in the requester's terminal.
    ROOTWHY_DEBUG=1 keeps them."""
    if os.environ.get("ROOTWHY_DEBUG"):
        return gtk_dialog(req)
    sys.stderr.flush()
    saved = os.dup(2)
    devnull = os.open(os.devnull, os.O_WRONLY)
    try:
        os.dup2(devnull, 2)
        return gtk_dialog(req)
    finally:
        os.dup2(saved, 2)
        os.close(saved)
        os.close(devnull)


def show_dialog(req: Request) -> str | None:
    if os.environ.get("ROOTWHY_DIALOG") != "fallback":
        try:
            return _gtk_quiet(req)
        except (ImportError, ValueError, RuntimeError, AttributeError):  # no GTK 4/3 or no display
            if req.screenshot:
                raise
    return fallback_dialog(req)


# ── modes ───────────────────────────────────────────────────────────────────────────────────────────────────

SUDO_PATHS = ("/usr/bin/sudo", "/bin/sudo", "/usr/local/bin/sudo")
# variables the dialog process keeps; anything else (PYTHON*, GI_*, GIO_*, GTK_*, QT_PLUGIN_PATH, LD_*…) could load
# foreign code into the process that holds the password
SAFE_ENV = ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "XDG_RUNTIME_DIR", "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP",
            "XDG_SESSION_DESKTOP", "DESKTOP_SESSION", "KDE_FULL_SESSION", "KDE_SESSION_VERSION",
            "DBUS_SESSION_BUS_ADDRESS", "HOME", "USER", "LOGNAME", "LANG", "LANGUAGE", "XCURSOR_THEME", "XCURSOR_SIZE")


def parse_sudo_cmdline(raw: bytes) -> list[str] | None:
    """The command from the parent's /proc cmdline, only for the exact form rootwhy uses: sudo -k -A -- /abs/command…
    (an absolute path, so the dialog cannot resolve a bare name differently than sudo does)"""
    parts = raw.decode("utf-8", "surrogateescape").split("\0")
    if parts and parts[-1] == "":
        parts.pop()
    if len(parts) < 5 or os.path.basename(parts[0]) != "sudo" or parts[1:4] != ["-k", "-A", "--"] \
            or not parts[4].startswith("/") or os.path.normpath(parts[4]) != parts[4]:
        return None
    return parts[4:]


def sudo_parent_command(pid: int) -> list[str] | None:
    """The command the parent sudo will run — None unless the parent really is sudo started by this user.
    The process name can be faked, so also: real UID is ours, effective UID is 0 (only a setuid-root program gets
    that), and the executable — when the kernel lets us see it — is a root-owned setuid sudo."""
    proc = Path(f"/proc/{pid}")
    try:
        if (proc / "comm").read_text().strip() != "sudo":
            return None
        uid = next(line.split()[1:3] for line in (proc / "status").read_text().splitlines() if line.startswith("Uid:"))
        if int(uid[0]) != os.getuid() or int(uid[1]) != 0:
            return None
        try:
            exe = os.readlink(proc / "exe")
        except PermissionError:  # normal for a setuid process
            exe = None
        if exe is not None:
            st = os.stat(exe)
            if exe not in SUDO_PATHS or st.st_uid != 0 or not st.st_mode & stat.S_ISUID:
                return None
        return parse_sudo_cmdline((proc / "cmdline").read_bytes())
    except (OSError, StopIteration, ValueError, IndexError):
        return None


def _safe_environ() -> None:
    keep = {k: v for k, v in os.environ.items() if k in SAFE_ENV or k.startswith(("LC_", "ROOTWHY_"))}
    os.environ.clear()
    os.environ.update(keep, PATH=SECURE_PATH)


def _caller_chain(pid: int, depth: int = 3) -> str:
    names = []
    for _i in range(depth):
        try:
            stat_line = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            break
        names.append(stat_line[stat_line.index("(") + 1:stat_line.rindex(")")])
        pid = int(stat_line[stat_line.rindex(")") + 2:].split()[1])
        if pid <= 1:
            break
    return " → ".join(reversed(names))  # outermost program first


def askpass_mode() -> int:
    """Run by sudo -A: show the dialog, print the password. Only when the parent process is sudo — an inherited
    environment must not turn this into a password prompt for whoever started it."""
    argv = sudo_parent_command(os.getppid())
    if not argv:
        print(_("rootwhy: askpass mode is only for sudo -A"), file=sys.stderr)
        return 1
    _safe_environ()
    state = os.environ.get("ROOTWHY_STATE", "")
    previous = ""
    if state:
        try:
            previous = Path(state).read_text().strip()
        except OSError:
            pass
    if previous == "cancelled":  # sudo asks again after a cancel — no second dialog
        return 1
    attempt = int(previous) + 1 if previous.isdigit() else 1
    if state:
        Path(state).write_text(str(attempt))
    # the command shown is the one sudo will run (its own cmdline); the reason is the requester's claim
    req = Request(reason=os.environ.get("ROOTWHY_REASON", ""), argv=argv, attempt=attempt,
                  cwd=os.environ.get("ROOTWHY_CWD", ""), caller=os.environ.get("ROOTWHY_CALLER", ""))
    password = show_dialog(req)
    if password is None:
        if state:
            Path(state).write_text("cancelled")
            # sudo would print "no password was provided"; it has run nothing yet, so end it quietly — the parent
            # rootwhy reports the cancel (sudo_parent_command checked that the parent is our sudo)
            os.kill(os.getppid(), signal.SIGKILL)
        return 1
    sys.stdout.write(password + "\n")
    sys.stdout.flush()
    return 0


def _clean(text: str) -> str:
    return re.sub(r"[\x00-\x1f\x7f]", " ", text).strip()


def _log(log_dir: Path, reason: str, command: str, status: str) -> None:
    try:
        log_dir.mkdir(parents=True, exist_ok=True)
        now = _dt.datetime.now()
        with open(log_dir / f"{now:%Y%m}.log", "a", encoding="utf-8") as f:
            f.write(f"{now:%Y-%m-%d %H:%M:%S} | {reason} | {command} | {status}\n")
    except OSError as e:
        print(f"rootwhy: log: {e}", file=sys.stderr)


def parse_args(args: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="rootwhy",
        description=L("Run a command as root after a password dialog that shows why, the command in coloured parts "
                      "and, on hover, each part's description from the system's man pages.",
                      "Uruchamia polecenie jako root po haśle w okienku, które pokazuje po co, polecenie w kolorowych "
                      "częściach i — po najechaniu — opis każdej części z podręcznika systemu (man)."),
        epilog=L('Example: rootwhy -r "Restart Ollama after changing its service file." '
                 'systemctl restart ollama',
                 'Przykład: rootwhy -r "Restart Ollamy po zmianie pliku usługi." '
                 'systemctl restart ollama'))
    p.add_argument("-r", "--reason", default="",
                   help=L(f"why the command is needed, {REASON_MIN}–{REASON_MAX} characters (required)",
                          f"po co jest polecenie, {REASON_MIN}–{REASON_MAX} znaków (wymagane)"))
    p.add_argument("--log-dir", default=os.environ.get("ROOTWHY_LOG_DIR", ""),
                   help=L("log directory (default: $XDG_STATE_HOME/rootwhy)",
                          "katalog dziennika (domyślnie $XDG_STATE_HOME/rootwhy)"))
    p.add_argument("--preview", action="store_true",
                   help=L("only show the dialog; run nothing", "tylko pokaż okienko; niczego nie uruchamiaj"))
    p.add_argument("--screenshot", default="", metavar="PNG", help=argparse.SUPPRESS)
    p.add_argument("--version", action="version", version=f"rootwhy {VERSION}")
    p.add_argument("command", nargs=argparse.REMAINDER)
    ns = p.parse_args(args)
    if ns.command and ns.command[0] == "--":
        ns.command = ns.command[1:]
    return ns


def main_mode(args: list[str]) -> int:
    ns = parse_args(args)
    reason = _clean(ns.reason)
    if not REASON_MIN <= len(reason) <= REASON_MAX:
        print(_("rootwhy: reason (-r) is required, {a}–{b} characters", a=REASON_MIN, b=REASON_MAX), file=sys.stderr)
        return 2
    if not ns.command:
        print(_("rootwhy: no command given"), file=sys.stderr)
        return 2
    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        print(_("rootwhy: no graphical session for the dialog"), file=sys.stderr)
        return 2
    caller = _caller_chain(os.getppid())
    if ns.preview or ns.screenshot:
        req = Request(reason, ns.command, cwd=os.getcwd(), caller=caller, preview=True,
                      screenshot=ns.screenshot)
        return 0 if show_dialog(req) is not None else 130

    # resolve once, so the path shown is the path sudo runs (sudo's own PATH may differ from this shell's)
    if "/" not in ns.command[0]:
        resolved = shutil.which(ns.command[0], path=SECURE_PATH) or shutil.which(ns.command[0])
        if not resolved:
            print(_("rootwhy: command not found: {c}", c=ns.command[0]), file=sys.stderr)
            return 127
        ns.command[0] = resolved
    elif not ns.command[0].startswith("/") or os.path.normpath(ns.command[0]) != ns.command[0]:
        ns.command[0] = os.path.realpath(ns.command[0])  # ./x, a/../b: the file the kernel would really run
    command = " ".join(shell_quote(a) for a in ns.command)
    log_dir = Path(ns.log_dir) if ns.log_dir else \
        Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "rootwhy"
    _log(log_dir, reason, command, "start")
    fd, state = tempfile.mkstemp(prefix="rootwhy.", dir=os.environ.get("XDG_RUNTIME_DIR") or None)
    os.close(fd)
    env = {k: v for k, v in os.environ.items() if not k.startswith(("ROOTWHY_", "SUDO_"))}
    env.update(ROOTWHY_MODE="askpass", ROOTWHY_STATE=state, ROOTWHY_REASON=reason,
               ROOTWHY_CWD=os.getcwd(), ROOTWHY_CALLER=caller, SUDO_ASKPASS=os.path.realpath(__file__))
    try:
        sudo = "/usr/bin/sudo" if os.path.exists("/usr/bin/sudo") else "sudo"
        code = subprocess.run([sudo, "-k", "-A", "--", *ns.command], check=False, env=env).returncode
        cancelled = Path(state).read_text().strip() == "cancelled"
    except KeyboardInterrupt:
        code, cancelled = 130, False
    finally:
        Path(state).unlink(missing_ok=True)
    if cancelled:
        code = 130
        print(_("rootwhy: cancelled by the user"), file=sys.stderr)
    _log(log_dir, reason, command, f"exit {code}")
    return code


def main() -> int:
    if os.environ.get("ROOTWHY_MODE") == "askpass":
        return askpass_mode()
    return main_mode(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
