VALUE_OPTIONS: dict[str, set[str]] = {
    "bash": {"-c"}, "sh": {"-c"},
    "cp": {"-t", "--target-directory"}, "mv": {"-t", "--target-directory"}, "ln": {"-t", "--target-directory"},
